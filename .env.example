# ==============================================================================
# GHAZARA V2 — PRODUCTION & LOCAL ENVIRONMENT CONFIGURATION
# ==============================================================================

# Node Environment ("development" | "production")
NODE_ENV=production
PORT=3000

# ------------------------------------------------------------------------------
# 1. Database (MySQL / TiDB / Serverless MySQL)
# Used for storing RFQ requests and user authentication records.
# Example: mysql://username:password@host:3306/database_name?ssl={"rejectUnauthorized":true}
# ------------------------------------------------------------------------------
DATABASE_URL=mysql://ghazara:ghazara_pw@localhost:3306/ghazara

# ------------------------------------------------------------------------------
# 2. Authentication & Session Secrets
# Generate a secure 32+ character random string for production.
# ------------------------------------------------------------------------------
JWT_SECRET=your_production_jwt_secret_key_here

# ------------------------------------------------------------------------------
# 3. GitHub Integration (For Dashboard Repository Activity)
# Classic token with `repo` scope or Fine-grained token with `Contents: read` & `Metadata: read`
# ------------------------------------------------------------------------------
GITHUB_TOKEN=ghp_your_github_token_here

# ------------------------------------------------------------------------------
# 4. Email & Activity Notifications
# ------------------------------------------------------------------------------
ACTIVITY_SUMMARY_RUN_HOUR=8
ACTIVITY_SUMMARY_RECIPIENT=info@ghazara.net

# ------------------------------------------------------------------------------
# 5. Optional OAuth / External Integration Providers
# ------------------------------------------------------------------------------
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
VITE_APP_ID=ghazara-v2
VITE_OAUTH_PORTAL_URL=
